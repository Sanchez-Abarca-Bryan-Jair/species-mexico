    "DATABASE_URL = \"postgresql://ususario:contraseña@ep-autumn-surf-bendmt3z-pooler.c-9.us-east-2.aws.neon.tech:5432/neondb?sslmode=require\"\n",
    "\n",
    "def cargar_con_copy(conn, df, tabla, columnas):\n",
    "    buffer = io.StringIO()\n",
    "    df[columnas].to_csv(buffer, index=False, header=False, na_rep=\"\\\\N\")\n",
    "    buffer.seek(0)\n",
    "    \n",
    "    cols_str = \", \".join(columnas)\n",
    "    with conn.cursor() as cur:\n",
    "        with cur.copy(f\"COPY {tabla} ({cols_str}) FROM STDIN WITH (FORMAT csv, NULL '\\\\N')\") as copy:\n",
    "            while data := buffer.read(65536):\n",
    "                copy.write(data)\n",
    "    conn.commit()\n",
    "    print(f\"Tabla '{tabla}' cargada: {len(df):,} filas.\")\n",
    "\n",
    "with psycopg.connect(DATABASE_URL) as conn:\n",
    "    # 1. Catálogos padre\n",
    "    cargar_con_copy(conn, df_estados, \"estados\", [\"cve_ent\", \"nombre\"])\n",
    "    cargar_con_copy(conn, df_municipios, \"municipios\", [\"cvegeo\", \"cve_ent\", \"nombre\"])\n",
    "    cargar_con_copy(conn, df_especies_sql, \"especies\", [\n",
    "        \"especie_id\", \"clase\", \"orden\", \"familia\", \"genero\", \"especie\",\n",
    "        \"nombre_comun\", \"es_invasora\", \"es_importancia_medica\", \"riesgo_principal\"\n",
    "    ])\n",
    "    \n",
    "    # 2. Tablas dependientes\n",
    "    cargar_con_copy(conn, df_clima, \"clima_mensual\", [\n",
    "        \"cve_ent\", \"anio\", \"mes\", \"temp_media\", \"precipitacion_mm\"\n",
    "    ])\n",
    "    cargar_con_copy(conn, df_obs_sql, \"observaciones\", [\n",
    "        \"gbif_id\", \"especie_id\", \"cve_ent\", \"cvegeo\",\n",
    "        \"fecha\", \"anio\", \"mes\", \"doy\", \"latitud\", \"longitud\", \"en_anp\"\n",
    "    ])"
   ]
