    "import psycopg\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "DATABASE_URL = \"postgresql://usuario:contraseña@ep-autumn-surf-bendmt3z-pooler.c-9.us-east-2.aws.neon.tech:5432/neondb?sslmode=require\"\n",
    "\n",
    "def sql_a_df(query: str, params: tuple = None) -> pd.DataFrame:\n",
    "    with psycopg.connect(DATABASE_URL) as conn:\n",
    "        with conn.cursor() as cur:\n",
    "            cur.execute(query, params)\n",
    "            cols = [desc[0] for desc in cur.description]\n",
    "            return pd.DataFrame(cur.fetchall(), columns=cols)"
   ]
