    "import time\n",
    "import requests\n",
    "ent_gdf = gpd.read_file(\"data/poligonos/00ent.shp\").to_crs(epsg=4326)\n",
    "ent_gdf[\"punto\"] = ent_gdf.geometry.representative_point()\n",
    "\n",
    "url = \"https://archive-api.open-meteo.com/v1/archive\"\n",
    "\n",
    "# Diccionario para conservar el avance si necesitas volver a ejecutar la celda\n",
    "if \"clima_por_estado\" not in locals():\n",
    "    clima_por_estado = {}\n",
    "\n",
    "for _, row in ent_gdf.iterrows():\n",
    "    cve_ent = row[\"CVE_ENT\"]\n",
    "    if cve_ent in clima_por_estado:\n",
    "        continue  # Salta los estados ya descargados\n",
    "\n",
    "    params = {\n",
    "        \"latitude\": round(row[\"punto\"].y, 4),\n",
    "        \"longitude\": round(row[\"punto\"].x, 4),\n",
    "        \"start_date\": \"2016-01-01\",\n",
    "        \"end_date\": \"2026-10-31\",\n",
    "        \"daily\": \"temperature_2m_mean,precipitation_sum\",\n",
    "        \"timezone\": \"America/Mexico_City\"\n",
    "    }\n",
    "\n",
    "    # Reintento automático si Open-Meteo devuelve 429\n",
    "    while True:\n",
    "        resp = requests.get(url, params=params, timeout=30)\n",
    "        if resp.status_code == 429:\n",
    "            print(f\"Límite alcanzado en estado {cve_ent}. Esperando 60s...\")\n",
    "            time.sleep(60)\n",
    "            continue\n",
    "        resp.raise_for_status()\n",
    "        break\n",
    "\n",
    "    daily = resp.json()[\"daily\"]\n",
    "    df_temp = pd.DataFrame({\n",
    "        \"fecha\": pd.to_datetime(daily[\"time\"]),\n",
    "        \"temp_media\": daily[\"temperature_2m_mean\"],\n",
    "        \"precipitacion_mm\": daily[\"precipitation_sum\"]\n",
    "    })\n",
    "    df_temp[\"anio\"] = df_temp[\"fecha\"].dt.year\n",
    "    df_temp[\"mes\"] = df_temp[\"fecha\"].dt.month\n",
    "\n",
    "    df_mes = df_temp.groupby([\"anio\", \"mes\"], as_index=False).agg(\n",
    "        temp_media=(\"temp_media\", \"mean\"),\n",
    "        precipitacion_mm=(\"precipitacion_mm\", \"sum\")\n",
    "    )\n",
    "    df_mes.insert(0, \"cve_ent\", cve_ent)\n",
    "    clima_por_estado[cve_ent] = df_mes\n",
    "\n",
    "    print(f\"Estado {cve_ent} ({row['NOMGEO']}) descargado ({len(clima_por_estado)}/32).\")\n",
    "    time.sleep(3)\n",
    "\n",
    "# Unir y guardar\n",
    "df_clima = pd.concat(clima_por_estado.values(), ignore_index=True)\n",
    "df_clima[\"temp_media\"] = df_clima[\"temp_media\"].round(2)\n",
    "df_clima[\"precipitacion_mm\"] = df_clima[\"precipitacion_mm\"].round(2)\n",
    "df_clima.to_csv(\"data/clima_mensual.csv\", index=False)\n",
    "print(f\"Listo. Total de filas: {len(df_clima):,}\")"
   ]
  },
