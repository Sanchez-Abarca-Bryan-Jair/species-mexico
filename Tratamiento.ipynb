   "source": [
    "cols_utiles = [\n",
    "    \"catalogNumber\", \"class\", \"order\", \"family\", \"genus\", \"species\",\n",
    "    \"decimalLatitude\", \"decimalLongitude\", \"eventDate\", \"year\", \"month\", \"day\",\n",
    "    \"coordinateUncertaintyInMeters\"\n",
    "]\n",
    "df_observaciones = df_observaciones[cols_utiles].copy()\n",
    "\n",
    "# Eliminar filas sin género (no sirven ni para importancia médica ni para especie)\n",
    "df_observaciones = df_observaciones.dropna(subset=[\"genus\"])\n",
    "\n",
    "# Rellenar especie faltante con \"Genero sp.\" para no perder registros de importancia médica\n",
    "df_observaciones[\"species\"] = df_observaciones[\"species\"].fillna(df_observaciones[\"genus\"] + \" sp.\")\n",
    "\n",
    "# Calcular el Día del Año (DOY) para fenología\n",
    "fechas_dt = pd.to_datetime(df_observaciones[\"eventDate\"], errors=\"coerce\")\n",
    "\n",
    "df_observaciones[\"fecha\"] = fechas_dt.dt.date\n",
    "df_observaciones[\"doy\"] = fechas_dt.dt.dayofyear"
   ]
  },
