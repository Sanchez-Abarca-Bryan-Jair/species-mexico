    "\n",
    "df_estados[\"nombre\"] = corregir_acentos(df_estados[\"nombre\"])\n",
    "df_municipios[\"nombre\"] = corregir_acentos(df_municipios[\"nombre\"])\n",
    "\n",
    "# Leer 00ent.shp con UTF-8, simplificar geometrías y exportar para Streamlit\n",
    "ent_gdf = gpd.read_file(\"data/poligonos/00ent.shp\", encoding=\"utf-8\").to_crs(epsg=4326)\n",
    "ent_gdf[\"geometry\"] = ent_gdf[\"geometry\"].simplify(tolerance=0.005, preserve_topology=True)\n",
    "ent_gdf[[\"CVE_ENT\", \"NOMGEO\", \"geometry\"]].rename(\n",
    "    columns={\"CVE_ENT\": \"cve_ent\", \"NOMGEO\": \"nombre\"}\n",
    ").to_file(\"data/estados_simplificado.geojson\", driver=\"GeoJSON\")\n",
    "\n",
    "print(df_estados[df_estados[\"cve_ent\"].isin([\"09\", \"16\", \"31\"])])"
