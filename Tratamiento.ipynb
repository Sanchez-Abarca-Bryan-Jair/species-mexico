    "q_anual = \"\"\"\n",
    "    SELECT \n",
    "        anio,\n",
    "        COUNT(*) AS total_obs,\n",
    "        COUNT(DISTINCT especie_id) AS especies_unicas,\n",
    "        ROUND(AVG(CASE WHEN en_anp THEN 1.0 ELSE 0.0 END) * 100, 1) AS pct_en_anp\n",
    "    FROM observaciones\n",
    "    GROUP BY anio\n",
    "    ORDER BY anio;\n",
    "\"\"\"\n",
    "df_anual = sql_a_df(q_anual)\n",
    "print(df_anual)\n",
    "\n",
    "df_anual.plot(x=\"anio\", y=\"total_obs\", kind=\"bar\", figsize=(9, 4), legend=False, title=\"Observaciones por año en México\")\n",
