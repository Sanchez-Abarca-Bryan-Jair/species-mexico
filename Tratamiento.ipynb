   "outputs": [],
   "source": [
    "df_observaciones = df_observaciones.drop_duplicates(subset=[\"catalogNumber\"])\n",
    "\n",
    "for col in [\"class\", \"order\", \"family\", \"genus\", \"species\"]:\n",
    "    df_observaciones[col] = df_observaciones[col].str.strip()\n",
    "\n",
    "df_observaciones[\"order\"] = df_observaciones[\"order\"].fillna(\"Sin clasificar\")\n",
    "df_observaciones[\"family\"] = df_observaciones[\"family\"].fillna(\"Sin clasificar\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "0f71eab5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Conservar nulos O registros con incertidumbre <= 10,000 metros\n",
    "df_observaciones = df_observaciones[\n",
    "    df_observaciones[\"coordinateUncertaintyInMeters\"].isna() | \n",
    "    (df_observaciones[\"coordinateUncertaintyInMeters\"] <= 10000)\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "aad0b3dd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Registros dentro de México: 691,405\n",
      "Registros dentro de ANP: 126,998\n"
     ]
    }
   ],
   "source": [
    "import geopandas as gpd\n",
    "\n",
    "# 1. Convertir observaciones a GeoDataFrame\n",
    "obs_gdf = gpd.GeoDataFrame(\n",
    "    df_observaciones,\n",
    "    geometry=gpd.points_from_xy(\n",
    "        df_observaciones[\"decimalLongitude\"], \n",
    "        df_observaciones[\"decimalLatitude\"]\n",
    "    ),\n",
    "    crs=\"EPSG:4326\"\n",
    ")\n",
    "\n",
    "# 2. Cargar municipios y estados (INEGI)\n",
    "mun_gdf = gpd.read_file(\"data/poligonos/00mun.shp\").to_crs(epsg=4326)\n",
    "ent_gdf = gpd.read_file(\"data/poligonos/00ent.shp\").to_crs(epsg=4326)\n",
    "\n",
    "# Extraer catálogos limpios para subir después a Neon\n",
    "df_estados = (\n",
    "    ent_gdf[[\"CVE_ENT\", \"NOMGEO\"]]\n",
    "    .drop_duplicates()\n",
    "    .rename(columns={\"CVE_ENT\": \"cve_ent\", \"NOMGEO\": \"nombre\"})\n",
    ")\n",
    "df_municipios = (\n",
    "    mun_gdf[[\"CVEGEO\", \"CVE_ENT\", \"NOMGEO\"]]\n",
    "    .drop_duplicates()\n",
    "    .rename(columns={\"CVEGEO\": \"cvegeo\", \"CVE_ENT\": \"cve_ent\", \"NOMGEO\": \"nombre\"})\n",
    ")\n",
    "\n",
    "# 3. Primer Spatial Join: asignar estado y municipio (descarta puntos fuera de México)\n",
    "obs_espacial = gpd.sjoin(\n",
    "    obs_gdf, \n",
    "    mun_gdf[[\"CVEGEO\", \"CVE_ENT\", \"geometry\"]], \n",
    "    how=\"inner\", \n",
    "    predicate=\"within\"\n",
    ").drop(columns=[\"index_right\"])\n",
    "\n",
    "# 4. Cargar y unir ambas capas de Áreas Naturales Protegidas (CONABIO)\n",
    "anp_fed = gpd.read_file(\"data/poligonos/areas_naturales/areas_federales/anpjun2026gw.shp\").to_crs(epsg=4326)[[\"geometry\"]]\n",
    "anp_est = gpd.read_file(\"data/poligonos/areas_naturales/areas_municipales/anpest25gw.shp\").to_crs(epsg=4326)[[\"geometry\"]]\n",
    "\n",
    "anp_total = pd.concat([anp_fed, anp_est], ignore_index=True)\n",
    "\n",
    "# 5. Segundo Spatial Join: detectar si cae dentro de cualquier ANP\n",
    "obs_espacial = gpd.sjoin(\n",
    "    obs_espacial, \n",
    "    anp_total, \n",
    "    how=\"left\", \n",
    "    predicate=\"within\"\n",
    ")\n",
    "\n",
    "# 6. Bandera booleana y eliminación de duplicados por polígonos traslapados\n",
    "obs_espacial[\"en_anp\"] = obs_espacial[\"index_right\"].notna()\n",
    "obs_espacial = obs_espacial.drop_duplicates(subset=[\"catalogNumber\"])\n",
    "\n",
    "# 7. Regresar a DataFrame normal y renombrar columnas\n",
    "df_observaciones = pd.DataFrame(\n",
    "    obs_espacial.drop(columns=[\"geometry\", \"index_right\"])\n",
    ").rename(columns={\n",
    "    \"CVE_ENT\": \"cve_ent\",\n",
    "    \"CVEGEO\": \"cvegeo\"\n",
    "})\n",
    "\n",
    "print(f\"Registros dentro de México: {len(df_observaciones):,}\")\n",
    "print(f\"Registros dentro de ANP: {df_observaciones['en_anp'].sum():,}\")"
   ]
  },
