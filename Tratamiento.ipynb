    "q_feno_clima = \"\"\"\n",
    "    WITH feno AS (\n",
    "        SELECT \n",
    "            o.anio,\n",
    "            COUNT(*) AS registros,\n",
    "            PERCENTILE_CONT(0.1) WITHIN GROUP (ORDER BY o.doy) AS doy_inicio,\n",
    "            PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY o.doy) AS doy_pico,\n",
    "            PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY o.doy) AS doy_fin\n",
    "        FROM observaciones o\n",
    "        JOIN especies e ON o.especie_id = e.especie_id\n",
    "        WHERE e.orden = %s\n",
    "        GROUP BY o.anio\n",
    "    ),\n",
    "    clima AS (\n",
    "        SELECT anio, ROUND(AVG(temp_media)::numeric, 2) AS temp_media_nacional\n",
    "        FROM clima_mensual\n",
    "        GROUP BY anio\n",
    "    )\n",
    "    SELECT f.*, c.temp_media_nacional\n",
    "    FROM feno f\n",
    "    LEFT JOIN clima c ON f.anio = c.anio\n",
    "    ORDER BY f.anio;\n",
    "\"\"\"\n",
    "df_feno = sql_a_df(q_feno_clima, (\"Lepidoptera\",))\n",
    "print(df_feno)\n",
    "\n",
    "# Correlación rápida entre temperatura media y día pico\n",
    "print(\"Correlación Temp vs DOY pico:\", df_feno[\"temp_media_nacional\"].astype(float).corr(df_feno[\"doy_pico\"]))"
   ]
