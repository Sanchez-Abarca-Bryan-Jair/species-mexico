  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "1851a599",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total especies únicas: 14,506\n",
      "Especies de importancia médica detectadas: 92\n"
     ]
    }
   ],
   "source": [
    "\n",
    "df_especies = (\n",
    "    df_observaciones[[\"class\", \"order\", \"family\", \"genus\", \"species\"]]\n",
    "    .drop_duplicates(subset=[\"species\"])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "df_especies[\"especie_id\"] = df_especies.index + 1\n",
    "\n",
    "# Separar reglas: las que aplican a una especie puntual vs. las que aplican a todo el género\n",
    "reglas_especie = df_IM[df_IM[\"species\"].notna()][[\"species\", \"nombre_comun\", \"riesgo_principal\"]]\n",
    "reglas_genero = df_IM[df_IM[\"species\"].isna()][[\"genus\", \"nombre_comun\", \"riesgo_principal\"]]\n",
    "\n",
    "# 3. Primer cruce: por especie exacta (ej. Aedes aegypti)\n",
    "df_especies = df_especies.merge(reglas_especie, on=\"species\", how=\"left\")\n",
    "\n",
    "# 4. Segundo cruce: por género (ej. Loxosceles, Latrodectus, Centruroides)\n",
    "df_especies = df_especies.merge(\n",
    "    reglas_genero, \n",
    "    on=\"genus\", \n",
    "    how=\"left\", \n",
    "    suffixes=(\"\", \"_gen\")\n",
    ")\n",
    "\n",
    "# Combinar resultados (prioridad a la coincidencia por especie; si es nulo, toma la de género)\n",
    "df_especies[\"nombre_comun\"] = df_especies[\"nombre_comun\"].combine_first(df_especies[\"nombre_comun_gen\"])\n",
    "df_especies[\"riesgo_principal\"] = df_especies[\"riesgo_principal\"].combine_first(df_especies[\"riesgo_principal_gen\"])\n",
    "df_especies = df_especies.drop(columns=[\"nombre_comun_gen\", \"riesgo_principal_gen\"])\n",
    "\n",
    "# 5. Crear la bandera booleana para Neon\n",
    "df_especies[\"es_importancia_medica\"] = df_especies[\"riesgo_principal\"].notna()\n",
    "\n",
    "# (Opcional) Inicializar bandera de invasoras si aún no la cruzas\n",
    "df_especies[\"es_invasora\"] = False\n",
    "\n",
    "# 6. Regresar solo el 'especie_id' a df_observaciones y borrar columnas de texto repetidas\n",
    "df_observaciones = df_observaciones.merge(\n",
    "    df_especies[[\"species\", \"especie_id\"]], \n",
    "    on=\"species\", \n",
    "    how=\"left\"\n",
    ").drop(columns=[\"class\", \"order\", \"family\", \"genus\", \"species\"])\n",
    "\n",
    "# Verificación rápida\n",
    "print(f\"Total especies únicas: {len(df_especies):,}\")\n",
    "print(f\"Especies de importancia médica detectadas: {df_especies['es_importancia_medica'].sum():,}\")"
   ]
  },
